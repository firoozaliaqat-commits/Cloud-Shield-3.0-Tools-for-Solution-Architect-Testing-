{
  "id": null,
  "uid": "cs2-07-iperf3",
  "title": "CloudShield | iperf3 Network Throughput",
  "tags": [
    "CloudShield",
    "KooLab",
    "real metrics"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "editable": false,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "What these graphs measure",
      "type": "text",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Real metrics only.** Panels may display **No data** until you run the corresponding practical. WAF blocks before the backend are captured by the **WAF probe counters**, not the backend HTTP counter. CrowdSec decisions appear live on the CrowdSec tool page; the application ban chart is separate. The iperf3 panel measures one Docker bridge, **not cross-ECS VPC speed**."
      }
    },
    {
      "id": 2,
      "title": "Real last Docker bridge TCP Mbps",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cloudshield-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cloudshield_iperf_last_receiver_mbps",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "cloudshield-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Mbps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 18,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
