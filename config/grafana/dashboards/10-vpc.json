  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "How to read this dashboard",
      "type": "text",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Real metrics only.** All panels come from the CloudShield Prometheus scrape. **No data is not zero**. The original eight dashboards remain unchanged. Each container has its own local IP, but cross-ECS IP identity can be changed by NAT. IDS alerts are evidence from the isolated monitored network; Suricata IPS is not deployed inline in this profile."
      }
    },
    {
      "id": 2,
      "title": "ECS2 CPU percent",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cloudshield-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cloudshield_remote_ecs_cpu_percent",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "cloudshield-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 18,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
